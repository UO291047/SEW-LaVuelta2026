<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.uniovi.es" elementFormDefault="qualified" targetNamespace="http://www.uniovi.es" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="etapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="datosEtapa" />
				<xs:element ref="galeria" />
				<xs:element ref="ubiSalida" />
				<xs:element ref="ubiMeta" />
				<xs:element ref="hitos" />
				<xs:element ref="puntosAnonimos" />
				<xs:element ref="clasificacionEtapa" />
				<xs:element ref="clasificacionGeneral" />
				<xs:element ref="clasificacionEquipos" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="datosEtapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="nombre" />
				<xs:element ref="numero" />
				<xs:element ref="longitudEtapa" />
				<xs:element ref="fecha" />
				<xs:element ref="datosGanador" />
				<xs:element ref="desnivel" />
				<xs:element ref="ubiInicio" />
				<xs:element ref="ubiFinal" />
				<xs:element ref="tipoEtapa" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="datosGanador">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="tiempoGanador" />
				<xs:element ref="velMedia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="galeria">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="refs" />
				<xs:element ref="fotos" />
				<xs:element ref="videos" />
				<xs:element ref="sonidos" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="refs">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ref" />
				<xs:element ref="ref" />
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="ref" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="fotos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="foto" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="videos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="video" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="sonidos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="sonido" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="coords">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="longitud" />
				<xs:element ref="latitud" />
				<xs:element ref="altitud" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ubiSalida">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coords" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ubiMeta">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="coords" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="hitos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="hito" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="hito">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="nombre" />
				<xs:element ref="tipoHito" />
				<xs:element ref="coords" />
				<xs:element ref="distanciaSalida" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="puntosAnonimos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="puntoAnonimo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="puntoAnonimo">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="1" ref="nombre" />
				<xs:element ref="coords" />
				<xs:element ref="distanciaSalida" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificacionEtapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primero" />
				<xs:element ref="segundo" />
				<xs:element ref="tercero" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificacionGeneral">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primero" />
				<xs:element ref="segundo" />
				<xs:element ref="tercero" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificacionEquipos">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="primerEquipo" />
				<xs:element ref="segundoEquipo" />
				<xs:element ref="tercerEquipo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="primero">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="segundo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tercero">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ciclista" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="primerEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="segundoEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="tercerEquipo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="equipo" />
				<xs:element ref="diferencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="nombre" type="xs:string" />
	<xs:element name="numero" type="xs:string" />
	<xs:element name="longitudEtapa">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="fecha" type="xs:string" />
	<xs:element name="tiempoGanador" type="xs:string" />
	<xs:element name="velMedia">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="uEspacio" type="xs:string" use="required" />
					<xs:attribute name="uTiempo" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="desnivel">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ubiInicio" type="xs:string" />
	<xs:element name="ubiFinal" type="xs:string" />
	<xs:element name="tipoEtapa" type="xs:string" />
	<xs:element name="ref" type="xs:string" />
	<xs:element name="foto" type="xs:string" />
	<xs:element name="video" type="xs:string" />
	<xs:element name="sonido" type="xs:string" />
	<xs:element name="longitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="latitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="altitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="distanciaSalida">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="tipoHito">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="tipo" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ciclista" type="xs:string" />
	<xs:element name="equipo" type="xs:string" />
	<xs:element name="diferencia">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidades" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
</xs:schema>